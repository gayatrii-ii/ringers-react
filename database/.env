# Ringer PostgreSQL & Database Configuration
POSTGRES_DB=ringer_db
POSTGRES_USER=ringer_user
POSTGRES_PASSWORD=ringer_secure_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Standard Connection Strings:
# Spring Boot (JDBC):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ringer_db?currentSchema=identity,vendor,catalog,customer,order_management,delivery,payment,notification,audit
# SPRING_DATASOURCE_USERNAME=ringer_user
# SPRING_DATASOURCE_PASSWORD=ringer_secure_password

# Node.js / Prisma / Drizzle / Python SQLAlchemy:
# DATABASE_URL=postgresql://ringer_user:ringer_secure_password@localhost:5432/ringer_db?schema=public

# Supabase Local Settings (when using 'npx supabase start'):
# SUPABASE_DB_PORT=54322
# SUPABASE_STUDIO_URL= http://localhost:54323
# SUPABASE_API_URL= http://localhost:54321
