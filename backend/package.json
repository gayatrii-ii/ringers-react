{
  "name": "@ringers/backend",
  "version": "1.0.0",
  "description": "Ringers Platform Core Backend Service - Multi-Tenant, Modular Monolith",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
