# Ringers Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://ringer_user:ringer_secure_password@localhost:5432/ringer_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=ringer_user
DB_PASSWORD=ringer_secure_password
DB_NAME=ringer_db
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=30000

# Security & JWT Tokens
JWT_SECRET=ringers_super_secret_jwt_key_2026_production_change_in_prod
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_SECRET=ringers_super_secret_refresh_jwt_key_2026_production
JWT_REFRESH_EXPIRY=7d

# Super Admin Default Credentials
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_8_CHARS

# Razorpay Payment Gateway (get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Map & Location Services (100% Free OpenStreetMap & Nominatim - NO Google Maps required)
MAP_SERVICE_PROVIDER=openstreetmap
OSM_TILE_SERVER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_ROUTING_URL=https://router.project-osrm.org
OPENROUTESERVICE_API_KEY=

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=ringers-notifications
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ringers-notifications.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...=\n-----END PRIVATE KEY-----\n"

# SMTP Email Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Ringers <noreply@ringers.com>

# SMS Gateway Configuration
SMS_GATEWAY_PROVIDER=fast2sms
SMS_GATEWAY_API_KEY=YOUR_FAST2SMS_API_KEY
SMS_SENDER_ID=RINGER

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
